{
	"folders": [
		{
			"path": "my-workspace"
		},
		// {
		// 	"path": "../spa"
		// },
		// {
		// 	"path": "../framework"
		// },
		// {
		// 	"path": "../access"
		// },
		// {
		// 	"path": "../opc"
		// }
	],
	"settings": {
		"window.title": "Web",
		"typescript.tsdk.path": "node_modules/typescript/lib",
		"typescript.tsdk.enablePromptUseWorkspaceTsdk": true
	},
	"extensions": {
		"recommendations": [
			"angular.ng-template"
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [{
				"name": "ng serve",
				"type": "chrome",
				"request": "launch",
				"preLaunchTask": "npm: start",
				"url": "http://localhost:4200/",
				"userDataDir": false
			},
			{
				"name": "ng test",
				"type": "chrome",
				"request": "launch",
				"preLaunchTask": "npm: test",
				"url": "http://localhost:9876/debug.html"
			}
		]
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "npm: start",
				"type": "shell",
				"command": "npm start",
				"options": { "cwd": "${workspaceFolder:my-workspace}" },
				"isBackground": true,
				"problemMatcher": { "owner": "typescript", "pattern": "$tsc", "background": { "activeOnStart": true, "beginsPattern": { "regexp": "Changes detected" }, "endsPattern": { "regexp": "bundle generation (complete|failed)" } } }
			},
			{
				"label": "npm: test",
				"type": "shell",
				"command": "npm test",
				"options": { "cwd": "${workspaceFolder:my-workspace}" },
				"isBackground": true,
				"problemMatcher": { "owner": "typescript", "pattern": "$tsc", "background": { "activeOnStart": true, "beginsPattern": { "regexp": "Changes detected" }, "endsPattern": { "regexp": "bundle generation (complete|failed)" } } }
			},

			{
				"type": "npm",
				"script": "startxx",
				"problemMatcher": { "owner": "typescript", "pattern": "$tsc", "background": { "activeOnStart": true, "beginsPattern": { "regexp": "(.*?)" }, "endsPattern": { "regexp": "bundle generation complete" } } },
				"label": "npm: startx",
				"detail": "ng serve"
			},
			{
				"label": "build",
				"type": "shell",
				"command": "tput reset;ng build;",
				"problemMatcher": { "owner": "typescript", "pattern": "$tsc", "background": { "activeOnStart": true, "beginsPattern": { "regexp": "(.*?)" }, "endsPattern": { "regexp": "bundle generation complete" } } },
				"group": { "kind": "build", "isDefault": true }
			}
		]
	}
}