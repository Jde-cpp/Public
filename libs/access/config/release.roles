mutation{
	createRole( target:"viewer", name:"Viewer", description:"Reads values and browses; changes nothing. Where to put a user you haven't classified yet." )
	addRole( target:"viewer", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"access", target:"acl" } } )
	addRole( target:"viewer", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"access", target:"groups" } } )
	addRole( target:"viewer", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"access", target:"providerTypes" } } )
	addRole( target:"viewer", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"access", target:"roles" } } )
	addRole( target:"viewer", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"access", target:"users" } } )
	addRole( target:"viewer", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"app", target:"instances" } } )
	addRole( target:"viewer", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"app", target:"instanceTagLevels" } } )
	addRole( target:"viewer", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"gateway", target:"serverConnections" } } )
	addRole( target:"viewer", permissionRight:{ allowed:2, denied:0, resource:{ schemaName:"opc.install", target:"nodeIds" } } )

	createRole( target:"sa", name:"System Administrator", description:"Users, roles, permissions, certificate trust and log settings. Grants access to everyone else." )
	addRole( target:"sa", role:{ target:"viewer" } )
	addRole( target:"sa", permissionRight:{ allowed:32, denied:0, resource:{ schemaName:"access", target:"acl" } } )
	addRole( target:"sa", permissionRight:{ allowed:32, denied:0, resource:{ schemaName:"access", target:"groups" } } )
	addRole( target:"sa", permissionRight:{ allowed:32, denied:0, resource:{ schemaName:"access", target:"providerTypes" } } )
	addRole( target:"sa", permissionRight:{ allowed:32, denied:0, resource:{ schemaName:"access", target:"roles" } } )
	addRole( target:"sa", permissionRight:{ allowed:32, denied:0, resource:{ schemaName:"access", target:"users" } } )
	addRole( target:"sa", permissionRight:{ allowed:32, denied:0, resource:{ schemaName:"app", target:"instances" } } )
	addRole( target:"sa", permissionRight:{ allowed:32, denied:0, resource:{ schemaName:"app", target:"instanceTagLevels" } } )
	addRole( target:"sa", permissionRight:{ allowed:32, denied:0, resource:{ schemaName:"gateway", target:"serverConnections" } } )
	addRole( target:"sa", permissionRight:{ allowed:32, denied:0, resource:{ schemaName:"opc.install", target:"nodeIds" } } )

	createRole( target:"owner", name:"Owner", description:"Every permission on every resource. Break-glass only - routine administration belongs to System Administrator." )
	addRole( target:"owner", role:{ target:["sa", "viewer"] } )
	addRole( target:"owner", permissionRight:{ allowed:64, denied:0, resource:{ schemaName:"access", target:"acl" } } )
	addRole( target:"owner", permissionRight:{ allowed:29, denied:0, resource:{ schemaName:"access", target:"groups" } } )
	addRole( target:"owner", permissionRight:{ allowed:29, denied:0, resource:{ schemaName:"access", target:"providerTypes" } } )
	addRole( target:"owner", permissionRight:{ allowed:72, denied:0, resource:{ schemaName:"access", target:"resources" } } )
	addRole( target:"owner", permissionRight:{ allowed:93, denied:0, resource:{ schemaName:"access", target:"roles" } } )
	addRole( target:"owner", permissionRight:{ allowed:221, denied:0, resource:{ schemaName:"access", target:"users" } } )
	addRole( target:"owner", permissionRight:{ allowed:29, denied:0, resource:{ schemaName:"app", target:"instances" } } )
	addRole( target:"owner", permissionRight:{ allowed:29, denied:0, resource:{ schemaName:"app", target:"instanceTagLevels" } } )
	addRole( target:"owner", permissionRight:{ allowed:29, denied:0, resource:{ schemaName:"gateway", target:"serverConnections" } } )
	addRole( target:"owner", permissionRight:{ allowed:93, denied:0, resource:{ schemaName:"opc.install", target:"nodeIds" } } )

	createRole( target:"engineer", name:"Engineer", description:"Configures server connections, the nodes exposed from them, and subscriptions. No user administration." )
	addRole( target:"engineer", role:{ target:"viewer" } )

	createRole( target:"operator", name:"Operator", description:"Runs the process - reads and writes values on assigned equipment. No configuration." )
	addRole( target:"operator", role:{ target:"viewer" } )

	createRole( target:"maint-tech", name:"Maintenance Technician", description:"Tests and calibrates equipment; reads logs to diagnose faults. No configuration." )
	addRole( target:"maint-tech", role:{ target:"viewer" } )
}
