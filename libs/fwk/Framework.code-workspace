{
	"settings": {
		"window.title": "Fwk",
		"name": "fwk",
		"target": "Jde.Fwk.Tests",
		"testTarget": "${config:target}",
		"subDir": "libs/${config:name}",
		"workspace": "${workspaceFolder:src}/..",
		"cmake.sourceDirectory": "${config:workspace}/../..",
		"cmake.defaultActiveFolder": "${config:cmake.sourceDirectory}",
		"cmake.buildDirectory": "${command:jde.repoBuildDir}",
		"settings": "${workspaceFolder:tests}/config/Framework.Tests.jsonnet",
		"testSettings": "${config:settings}",
		"program": "${config:binDir}/${config:target}${config:targetExtension}"
	},
	"folders": [
		{
			"path": "src",
		},
		{
			"path": "tests"
		},
		{
			"path": "../../include/jde/fwk",
			"name": "include"
		}
	],
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Debug",
				"type": "lldb",
				"breakpointMode":"path",
				"request": "launch",
				"program": "${config:cmake.buildDirectory}/debug/${config:program}",
				"args": [
					"-tests",
					"-settings=${config:settings}"
				],
				"cwd": "${command:jde.repoBuildDir}/debug/runtime",
				"preLaunchTask": "build"
			}
		],
		"compounds": []
	}
}