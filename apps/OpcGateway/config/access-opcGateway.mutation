mutation{
	createGroup( slug: "OpcGateway" )
	createRole( slug: "OpcGateway", description: "Permissions for OpcGateways", permissionRights:[
		{resource: {slug: "users"}, allowed: ["Create", "Read", "Update", "Delete", "Purge"]},
		{resource: {slug: "groups"}, allowed: ["Read"]},
		{resource: {slug: "roles"}, allowed: ["Read"]}]
	)
}